<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="/Users/mayowa/Documents/My-Projects/Student-Grade-Predictor/data.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="5774"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="cleaned_data" custom_title="0" dock_id="2" table="4,12:maincleaned_data"/><dock_state state="000000ff00000000fd00000001000000020000037400000342fc0100000002fb000000160064006f0063006b00420072006f00770073006500310100000000000001c30000000000000000fb000000160064006f0063006b00420072006f00770073006500320100000000000003740000010f00ffffff000002830000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="cleaned_data" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="102"/><column index="2" value="82"/><column index="3" value="71"/><column index="4" value="67"/><column index="5" value="103"/><column index="6" value="84"/><column index="7" value="120"/><column index="8" value="86"/><column index="9" value="122"/><column index="10" value="82"/><column index="11" value="109"/><column index="12" value="111"/><column index="13" value="55"/><column index="14" value="107"/><column index="15" value="109"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Test Metrics
SELECT
	hours_studied,
	in_studygroup,
	avg_test_score,
	avg_confidence,
	test1_weighted,
	test2_weighted
FROM cleaned_data;

-- Class Metrics
SELECT
	attendance,
	difficulty,
	in_studygroup,
	avg_test_score,
	avg_confidence,
	final_grade,
	passed
FROM cleaned_data;


-- Do students who study more get betetr grades?
SELECT
    CASE
        WHEN hours_studied &lt;= 5 THEN 'Low (0-5 hours)'
        WHEN hours_studied &lt;= 10 THEN 'Medium (6-10 hours)'
        ELSE 'High (11+ hours)'
    END as study_levels,
    ROUND(AVG(final_grade)) as avg_finalgrade,
	ROUND(AVG(test1_score)) as avg_test1,
	ROUND(AVG(test2_score)) as avg_test2,
	COUNT(CASE WHEN passed = 1 THEN 1 END) as passed_count,
	COUNT(CASE WHEN passed = 0 THEN 1 END) as failed_count
	FROM cleaned_data
GROUP BY study_levels;

-- Did prior GPA affect final grade?
SELECT 
    CASE 
        WHEN prior_gpa &gt;= 3.58 THEN 'A (3.58 - 4.0)'
        WHEN prior_gpa &gt;= 3.18 THEN 'B (3.18 - 3.57)'
		WHEN prior_gpa &gt;= 2.78 THEN 'C (2.78 - 3.17)'
		WHEN prior_gpa &gt;= 2.38 THEN 'D (2.38 - 2.77)'
		WHEN prior_gpa &lt;= 2.37 THEN 'F (0.00 - 2.37)'
		ELSE 'Missing GPA Data' 
    END as gpa_levels,
    ROUND(AVG(final_grade), 1) as avg_final_grade,
    COUNT(*) as num_of_students
FROM cleaned_data
GROUP BY gpa_levels;

-- Does attendance matter?
SELECT 
    CASE 
        WHEN attendance &lt; 50 THEN 'Low (&lt;50%)'
        WHEN attendance &lt; 75 THEN 'Medium (50-75%)'
        ELSE 'High (&gt;75%)'
    END as attendance_level,
    ROUND(AVG(final_grade), 1) as avg_final_grade,
    COUNT(*) as num_of_students
FROM cleaned_data
GROUP BY attendance_level
ORDER BY avg_final_grade DESC;


SELECT 
    ROUND(AVG(final_grade), 1) as overall_average,
    MIN(final_grade) as lowest_grade,
    MAX(final_grade) as highest_grade,
    COUNT(*) as total_students
FROM cleaned_data;

--   Which was harder? (Test 1 vs Test 2)
SELECT 
    ROUND(AVG(test1_score), 1) as avg_test1,
    ROUND(AVG(test2_score), 1) as avg_test2,
    ROUND(AVG(test2_score) - AVG(test1_score), 1) as difference_in_score,
	ROUND(AVG(test1_confidence), 1) as avg_test1conf,
	ROUND(AVG(test2_confidence), 1) as avg_test2conf,
    ROUND(AVG(test2_confidence) - AVG(test1_confidence), 1) as difference_in_conf
FROM cleaned_data;

-- Students who were confident but scored poorly
SELECT 
    avg_confidence,
    avg_test_score,
    final_grade,
    (avg_confidence - (avg_test_score/10)) as confidence_score_gap
FROM cleaned_data
WHERE avg_confidence &gt; 4.5 AND avg_test_score &lt; 59.5
ORDER BY confidence_score_gap DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
